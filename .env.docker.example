GROQ_VISION_MODEL=qwen/qwen3.8-27b
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_ORIGINS=
NEXT_PUBLIC_API_BASE_URL=
