# Waste2Value — environment variables
#
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser —
# never put secrets there (see README "Environment Variables").

# Base URL of the backend REST API (SRS: token-based auth over HTTPS/REST).
# Optional until the backend lands; the service layer (src/services/) will
# read it when real endpoints replace the mocks.
NEXT_PUBLIC_API_BASE_URL=
