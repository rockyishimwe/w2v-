# Waste2Value — environment variables
#
# Copy this file to .env.local and fill in values:
#   cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser —
# never put secrets there (see README "Environment Variables").

# ── Frontend ──────────────────────────────────────────────────────
# Base URL of the backend REST API. Leave empty to use same-origin
# (the backend lives in this same Next.js app under /api).
NEXT_PUBLIC_API_BASE_URL=

# ── Database (required) ──────────────────────────────────────────
# PostgreSQL connection string. Use the POOLED url in production
# (serverless opens many short-lived connections).
# Example: postgresql://user:password@host:5432/waste2value
DATABASE_URL=
# Optional: direct (non-pooled) url used by `prisma migrate` only —
# pgbouncer-style poolers reject the statements migrations issue.
DIRECT_DATABASE_URL=
# Optional: max pool size per instance (default 5).
DATABASE_POOL_MAX=

# ── Image storage ────────────────────────────────────────────────
# Vercel Blob read/write token. When set, uploaded photos go to blob
# storage (required on Vercel — its filesystem is read-only). When
# unset, photos are written to ./uploads on local disk (dev, Docker).
BLOB_READ_WRITE_TOKEN=

# ── Auth (secrets — server only) ─────────────────────────────────
# HMAC secrets for JWT signing / refresh hashing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Groq AI (server only) ────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
# When unset, AI endpoints serve deterministic fallback content.
GROQ_API_KEY=
# Free-tier production models (verify at https://console.groq.com/docs/models):
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ── Social login (server only) ─────────────────────────────────
# Google: create OAuth 2.0 credentials at https://console.cloud.google.com
# ("OAuth client ID" → Web application). Register this redirect URI:
#   {APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL used to build OAuth redirect URIs. Must exactly match
# the URIs registered in the Google app settings.
APP_URL=http://localhost:3000

# ── Security ───────────────────────────────────────────────────
# Comma-separated origins allowed by CORS (empty = same-origin only).
ALLOWED_ORIGINS=
